{
  // Editor Configuration
  "editor.fontSize": 14,
  "editor.fontFamily": "'Fira Code', 'Hasklug Nerd Font', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.5,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.rulers": [80, 120],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,

  // Format & Save Configuration
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true,
    "source.organizeImports": true,
    "source.removeUnusedImports": true
  },

  // File Configuration
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // TypeScript & JavaScript
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.preferences.importModuleSpecifier": "relative",
  "javascript.suggest.autoImports": true,

  // React & JSX
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  "emmet.triggerExpansionOnTab": true,

  // ESLint Configuration
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.format.enable": true,

  // Prettier Configuration
  "prettier.singleQuote": true,
  "prettier.semi": true,
  "prettier.trailingComma": "es5",
  "prettier.tabWidth": 2,
  "prettier.printWidth": 80,
  "prettier.arrowParens": "avoid",

  // Default Formatters
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Git Configuration
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.autofetch": true,

  // Terminal Configuration
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "'Fira Code', 'Hasklug Nerd Font'",
  "terminal.integrated.shell.osx": "/bin/zsh",

  // Explorer Configuration
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,

  // Search Configuration
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/coverage": true,
    "**/.nyc_output": true
  },

  // Files to exclude from file watcher
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true
  },

  // React Specific Settings
  "typescript.preferences.includePackageJsonAutoImports": "auto",
  "typescript.suggest.completeFunctionCalls": true,

  // Testing Configuration
  "jest.autoRun": "watch",
  "jest.showCoverageOnLoad": false,

  // Live Server Configuration
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.port": 3000,

  // Tailwind CSS
  "tailwindCSS.includeLanguages": {
    "javascript": "javascript",
    "html": "html"
  },

  // Auto Close Tags
  "auto-close-tag.activationOnLanguage": [
    "xml",
    "php",
    "blade",
    "ejs",
    "jinja",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "plaintext",
    "markdown",
    "vue",
    "liquid",
    "erb",
    "lang-cfml",
    "cfml",
    "HTML (EEx)",
    "HTML (Eex)",
    "plist"
  ],

  // Import Cost Configuration
  "importCost.smallPackageSize": 50,
  "importCost.mediumPackageSize": 100,

  // Workbench Configuration
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "One Dark Pro",
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "newUntitledFile",

  // Language Specific Settings
  "javascript.format.semicolons": "insert",
  "typescript.format.semicolons": "insert",

  // Conventional Commits Configuration
  "conventionalCommits.showNewVersionNotes": false,
  "conventionalCommits.emojiFormat": "emoji",
  "conventionalCommits.promptBody": true,
  "conventionalCommits.promptFooter": true,
  "conventionalCommits.autoCommit": false,
  "conventionalCommits.scopes": [
    "ui", "components", "hooks", "pages", "auth", "api", "state", "routing", "forms",
    "config", "deps", "scripts", "webpack", "vite", "eslint", "prettier",
    "unit", "integration", "e2e", "test-utils", "mocks",
    "readme", "changelog", "docs", "storybook",
    "security", "monitoring", "analytics", "database"
  ],

  // Commitlint Extension
  "commitlint.configPath": "~/.config/commitlint/commitlint.config.js"
}