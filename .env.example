# Environment Configuration Template
# Copy this file to .env and customize with your personal settings

# Computer/Hostname Configuration
COMPUTER_NAME="your-hostname"

# Git Configuration (will be written to ~/.gitlocal)
GIT_USER_NAME="Your Full Name"
GIT_USER_EMAIL="your.email@example.com"

# Development Directories
# Uncomment and customize if you use different project organization
# PROJECTS_DIR="$HOME/Projects"
# REPOS_DIR="$HOME/Projects/Repos"
# FORKS_DIR="$HOME/Projects/Forks"
# PLAYGROUND_DIR="$HOME/Projects/Playground"

# Optional: Custom shell prompt (if not using starship)
# PROMPT_STYLE="spaceship"

# Optional: Override default editor
# EDITOR="code"

# React Development Configuration
REACT_DEFAULT_TEMPLATE="vite"
REACT_PROJECTS_DIR="$HOME/Dev/React"

# Node.js Configuration
NODE_ENV="development"
# NPM_CONFIG_PREFIX="$HOME/.npm-global"