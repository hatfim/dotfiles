# Backup folder
backup

# Custom files (*sh includes sh, bash, zsh)
custom/**/*.*sh

# Home Configs
home/.config/*
!home/.config/sheldon
!home/.config/gh/config.yml
!home/.config/iterm2
!home/.config/vscode
!home/.config/commitlint

# Environment configuration (contains sensitive data)
.env

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# iTerm2 backups (keep main config, ignore backups)
home/.config/iterm2/*.backup.*
