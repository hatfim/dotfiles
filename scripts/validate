#!/usr/bin/env bash

# Validation script for dotfiles installation
# Checks system requirements and validates configuration

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
info() { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $*"; }
warning() { echo -e "${YELLOW}[WARNING]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; }

# Check if command exists
command_exists() {
  command -v "$1" >/dev/null 2>&1
}

# Validation functions
validate_os() {
  info "Validating operating system..."
  if [[ "$OSTYPE" == "darwin"* ]]; then
    success "macOS detected"
    return 0
  elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    success "Linux detected"
    return 0
  else
    error "Unsupported operating system: $OSTYPE"
    return 1
  fi
}

validate_shell() {
  info "Validating shell..."
  if [[ -z "${ZSH_VERSION:-}" ]]; then
    warning "Not running in Zsh. Some features may not work correctly."
    return 1
  else
    success "Running in Zsh"
    return 0
  fi
}

validate_dependencies() {
  info "Checking required dependencies..."
  local missing=0

  local required_commands=("git" "curl" "brew")
  for cmd in "${required_commands[@]}"; do
    if command_exists "$cmd"; then
      success "$cmd is installed"
    else
      error "$cmd is not installed"
      ((missing++))
    fi
  done

  return $missing
}

validate_dotfiles_structure() {
  info "Validating dotfiles structure..."
  local dotfiles_dir="${DOTFILES:-$HOME/.dotfiles}"

  if [[ ! -d "$dotfiles_dir" ]]; then
    error "Dotfiles directory not found: $dotfiles_dir"
    return 1
  fi

  local required_files=("install" "install.conf.yaml" "home/.zshrc")
  local missing=0

  for file in "${required_files[@]}"; do
    if [[ -f "$dotfiles_dir/$file" ]]; then
      success "Found $file"
    else
      error "Missing required file: $file"
      ((missing++))
    fi
  done

  return $missing
}

validate_permissions() {
  info "Checking file permissions..."
  local dotfiles_dir="${DOTFILES:-$HOME/.dotfiles}"

  if [[ ! -x "$dotfiles_dir/install" ]]; then
    warning "install script is not executable, attempting to fix..."
    chmod +x "$dotfiles_dir/install"
    if [[ -x "$dotfiles_dir/install" ]]; then
      success "Fixed install script permissions"
    else
      error "Failed to make install script executable"
      return 1
    fi
  else
    success "install script is executable"
  fi

  return 0
}

validate_git_config() {
  info "Checking git configuration..."

  if [[ -f "$HOME/.gitlocal" ]]; then
    success "Found ~/.gitlocal"
  else
    warning "~/.gitlocal not found. You may need to configure git user details."
    info "Run: git config -f ~/.gitlocal user.name 'Your Name'"
    info "Run: git config -f ~/.gitlocal user.email 'your@email.com'"
  fi

  return 0
}

main() {
  echo "=== Dotfiles Validation ==="
  echo

  local exit_code=0

  validate_os || exit_code=1
  validate_shell || true  # Don't fail on shell validation
  validate_dependencies || exit_code=1
  validate_dotfiles_structure || exit_code=1
  validate_permissions || exit_code=1
  validate_git_config || true  # Don't fail on git config validation

  echo
  if [[ $exit_code -eq 0 ]]; then
    success "All validations passed! Your dotfiles setup looks good."
  else
    error "Some validations failed. Please address the issues above."
  fi

  return $exit_code
}

# Run if script is executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi