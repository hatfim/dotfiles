#!/usr/bin/env bash

# Interactive Git Commit with Conventional Commit Selection
# Provides an auto-selection menu for commit types and scopes

set -euo pipefail

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Commit types with descriptions and emojis
declare -A COMMIT_TYPES=(
  ["feat"]="✨ New feature"
  ["fix"]="🐛 Bug fix"
  ["docs"]="📚 Documentation changes"
  ["style"]="💎 Code style changes (formatting, etc)"
  ["refactor"]="📦 Code refactoring"
  ["perf"]="🚀 Performance improvements"
  ["test"]="🚨 Adding or updating tests"
  ["build"]="🛠  Changes to build system or dependencies"
  ["ci"]="⚙️  Changes to CI configuration"
  ["chore"]="♻️  Other changes (maintenance, etc)"
  ["revert"]="🗑 Reverts a previous commit"
  ["hotfix"]="🔥 Critical fixes"
  ["wip"]="🚧 Work in progress"
)

# Common scopes for React/Frontend development
COMMON_SCOPES=(
  "ui" "components" "hooks" "pages" "auth" "api" "state" "routing" "forms"
  "config" "deps" "scripts" "webpack" "vite" "eslint" "prettier"
  "unit" "integration" "e2e" "test-utils" "mocks"
  "readme" "changelog" "docs" "storybook"
  "security" "monitoring" "analytics" "database"
)

# Functions
select_commit_type() {
  echo -e "${BOLD}${CYAN}Select commit type:${NC}"
  echo

  local types=($(printf '%s\n' "${!COMMIT_TYPES[@]}" | sort))
  local i=1

  for type in "${types[@]}"; do
    echo -e "${YELLOW}${i}.${NC} ${BLUE}${type}${NC} - ${COMMIT_TYPES[$type]}"
    ((i++))
  done

  echo
  read -p "Enter number (1-${#types[@]}): " selection

  if [[ "$selection" =~ ^[0-9]+$ ]] && [ "$selection" -ge 1 ] && [ "$selection" -le "${#types[@]}" ]; then
    echo "${types[$((selection-1))]}"
  else
    echo -e "${RED}Invalid selection. Exiting.${NC}"
    exit 1
  fi
}

select_scope() {
  echo
  echo -e "${BOLD}${CYAN}Select scope (optional):${NC}"
  echo -e "${YELLOW}0.${NC} ${BLUE}No scope${NC}"

  local i=1
  for scope in "${COMMON_SCOPES[@]}"; do
    echo -e "${YELLOW}${i}.${NC} ${BLUE}${scope}${NC}"
    ((i++))
  done

  echo -e "${YELLOW}${i}.${NC} ${BLUE}custom${NC} - Enter custom scope"

  echo
  read -p "Enter number (0-${i}): " selection

  if [ "$selection" = "0" ]; then
    echo ""
  elif [[ "$selection" =~ ^[0-9]+$ ]] && [ "$selection" -ge 1 ] && [ "$selection" -le "${#COMMON_SCOPES[@]}" ]; then
    echo "${COMMON_SCOPES[$((selection-1))]}"
  elif [ "$selection" = "$i" ]; then
    read -p "Enter custom scope: " custom_scope
    echo "$custom_scope"
  else
    echo -e "${RED}Invalid selection. No scope will be used.${NC}"
    echo ""
  fi
}

get_description() {
  echo
  echo -e "${BOLD}${CYAN}Enter commit description:${NC}"
  echo -e "${YELLOW}• Use imperative mood (\"add\" not \"added\")${NC}"
  echo -e "${YELLOW}• Keep under 72 characters${NC}"
  echo -e "${YELLOW}• Don't end with period${NC}"
  echo
  read -p "Description: " description
  echo "$description"
}

get_body() {
  echo
  echo -e "${BOLD}${CYAN}Enter commit body (optional):${NC}"
  echo -e "${YELLOW}• Explain what and why, not how${NC}"
  echo -e "${YELLOW}• Press Enter twice to finish${NC}"
  echo

  local body=""
  local line
  local empty_lines=0

  while IFS= read -r line; do
    if [[ -z "$line" ]]; then
      ((empty_lines++))
      if [ $empty_lines -ge 2 ]; then
        break
      fi
      body+=$'\n'
    else
      empty_lines=0
      body+="$line"$'\n'
    fi
  done

  echo "$body"
}

get_issues() {
  echo
  echo -e "${BOLD}${CYAN}Reference issues (optional):${NC}"
  echo -e "${YELLOW}• Format: \"Closes #123\" or \"Refs #456\"${NC}"
  echo
  read -p "Issues (or press Enter to skip): " issues
  echo "$issues"
}

confirm_commit() {
  local commit_msg="$1"

  echo
  echo -e "${BOLD}${CYAN}Commit message preview:${NC}"
  echo -e "${GREEN}┌─────────────────────────────────────────────────────────────────────────────┐${NC}"
  echo "$commit_msg" | while IFS= read -r line; do
    echo -e "${GREEN}│${NC} $line"
  done
  echo -e "${GREEN}└─────────────────────────────────────────────────────────────────────────────┘${NC}"
  echo

  read -p "Proceed with commit? (y/N): " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    return 0
  else
    return 1
  fi
}

main() {
  # Check if we're in a git repository
  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo -e "${RED}Error: Not in a git repository${NC}"
    exit 1
  fi

  # Check if there are staged changes
  if ! git diff --cached --quiet; then
    echo -e "${GREEN}✓ Found staged changes${NC}"
  else
    echo -e "${YELLOW}⚠ No staged changes found${NC}"
    read -p "Do you want to stage all changes? (y/N): " stage_all
    if [[ "$stage_all" =~ ^[Yy]$ ]]; then
      git add .
      echo -e "${GREEN}✓ All changes staged${NC}"
    else
      echo -e "${RED}Please stage your changes first with 'git add'${NC}"
      exit 1
    fi
  fi

  echo
  echo -e "${BOLD}${BLUE}🎯 Interactive Conventional Commit${NC}"
  echo -e "${BOLD}${BLUE}═══════════════════════════════════${NC}"

  # Get commit components
  local commit_type=$(select_commit_type)
  local scope=$(select_scope)
  local description=$(get_description)
  local body=$(get_body)
  local issues=$(get_issues)

  # Build commit message
  local commit_msg=""

  # Header: type(scope): description
  if [[ -n "$scope" ]]; then
    commit_msg="${commit_type}(${scope}): ${description}"
  else
    commit_msg="${commit_type}: ${description}"
  fi

  # Add body if provided
  if [[ -n "$body" && "$body" != $'\n' ]]; then
    commit_msg+=$'\n\n'"$body"
  fi

  # Add issues if provided
  if [[ -n "$issues" ]]; then
    if [[ -n "$body" && "$body" != $'\n' ]]; then
      commit_msg+=$'\n'"$issues"
    else
      commit_msg+=$'\n\n'"$issues"
    fi
  fi

  # Confirm and commit
  if confirm_commit "$commit_msg"; then
    git commit -m "$commit_msg"
    echo
    echo -e "${GREEN}✅ Commit successful!${NC}"

    # Show recent commit
    echo
    echo -e "${BOLD}${CYAN}Recent commits:${NC}"
    git log --oneline -n 3
  else
    echo -e "${YELLOW}❌ Commit cancelled${NC}"
    exit 1
  fi
}

# Run if script is executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi