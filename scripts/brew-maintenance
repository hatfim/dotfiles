#!/usr/bin/env bash

# Homebrew Maintenance Script
# Comprehensive cleanup and optimization for Homebrew

set -euo pipefail

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

info() { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $*"; }
warning() { echo -e "${YELLOW}[WARNING]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; }

# Check if Homebrew is installed
if ! command -v brew >/dev/null 2>&1; then
  error "Homebrew is not installed!"
  exit 1
fi

echo "🍺 Homebrew Maintenance & Optimization"
echo "======================================"

# 1. Update Homebrew
info "Updating Homebrew..."
brew update

# 2. Upgrade all packages
info "Upgrading all packages..."
brew upgrade

# 3. Clean up deprecated taps
info "Removing deprecated taps..."
deprecated_taps=(
  "homebrew/homebrew-bundle"
  "homebrew/homebrew-cask-fonts"
  "homebrew/homebrew-services"
)

for tap in "${deprecated_taps[@]}"; do
  if brew tap | grep -q "$tap"; then
    warning "Removing deprecated tap: $tap"
    brew untap "$tap" 2>/dev/null || true
  fi
done

# 4. Remove deprecated packages
info "Checking for deprecated packages..."
deprecated_formulae=(
  "tldr"
  "mailhog"
  "php@8.0"
  "youtube-dl"
)

deprecated_casks=(
  "fig"
  "qlimagesize"
  "sequel-pro"
)

for formula in "${deprecated_formulae[@]}"; do
  if brew list --formula | grep -q "^$formula$"; then
    warning "Removing deprecated formula: $formula"
    brew uninstall "$formula" 2>/dev/null || true
  fi
done

for cask in "${deprecated_casks[@]}"; do
  if brew list --cask | grep -q "^$cask$"; then
    warning "Removing deprecated cask: $cask"
    brew uninstall --cask "$cask" 2>/dev/null || true
  fi
done

# 5. Link any unlinked kegs
info "Linking unlinked kegs..."
brew link --overwrite php 2>/dev/null || true

# 6. Install missing packages from Brewfile
info "Installing packages from Brewfile..."
if [ -f "$DOTFILES/Brewfile" ]; then
  cd "$DOTFILES"
  brew bundle install --no-lock
  cd -
else
  warning "Brewfile not found at $DOTFILES/Brewfile"
fi

# 7. Cleanup
info "Cleaning up Homebrew..."
brew cleanup --prune=all
brew autoremove

# 8. Doctor check
info "Running Homebrew doctor..."
if brew doctor; then
  success "✅ Homebrew is healthy!"
else
  warning "⚠️ Homebrew doctor found some issues. Check output above."
fi

# 9. Display summary
echo
echo "📊 Homebrew Summary:"
echo "==================="
info "Formulae installed: $(brew list --formula | wc -l | tr -d ' ')"
info "Casks installed: $(brew list --cask | wc -l | tr -d ' ')"
info "Taps: $(brew tap | wc -l | tr -d ' ')"

# 10. Check for security updates
info "Checking for security updates..."
if brew outdated | grep -q security; then
  warning "Security updates available! Run 'brew upgrade' to install."
else
  success "No security updates needed."
fi

success "🎉 Homebrew maintenance complete!"

# Suggestions
echo
echo "💡 Additional Suggestions:"
echo "========================="
echo "• Run this script monthly for optimal performance"
echo "• Use 'brew bundle dump' to backup your current setup"
echo "• Consider 'brew services' to manage background services"
echo "• Check 'brew deps --tree' to understand dependencies"