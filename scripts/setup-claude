#!/usr/bin/env bash

# Claude Setup Script for Dotfiles
# Sets up Claude CLI, agents, and development environment

set -euo pipefail

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

info() { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $*"; }
warning() { echo -e "${YELLOW}[WARNING]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; }

# Configuration paths
CLAUDE_DIR="$HOME/.claude"
AGENTS_REPO="$HOME/Dev/Forks/claude-agents"
AGENTS_TARGET="$CLAUDE_DIR/agents/awesome-claude-agents"

# Check if Claude CLI is installed
check_claude_cli() {
  info "Checking Claude CLI installation..."

  if ! command -v claude >/dev/null 2>&1; then
    error "Claude CLI not found. Please install it first:"
    echo "• Visit: https://claude.ai/code"
    echo "• Follow installation instructions"
    echo "• Authenticate with your Claude account"
    exit 1
  fi

  success "Claude CLI found: $(which claude)"
}

# Verify Claude authentication
check_claude_auth() {
  info "Verifying Claude authentication..."

  # Try to run a simple Claude command to check auth
  if ! claude --help >/dev/null 2>&1; then
    warning "Claude CLI may not be properly authenticated"
    echo "Run 'claude auth' to authenticate with your Claude account"
  else
    success "Claude CLI appears to be working"
  fi
}

# Setup Claude directory structure
setup_claude_directories() {
  info "Setting up Claude directory structure..."

  local directories=(
    "$CLAUDE_DIR"
    "$CLAUDE_DIR/agents"
    "$CLAUDE_DIR/plugins"
    "$CLAUDE_DIR/projects"
    "$CLAUDE_DIR/shell-snapshots"
    "$CLAUDE_DIR/configs"
  )

  for dir in "${directories[@]}"; do
    if [ ! -d "$dir" ]; then
      mkdir -p "$dir"
      info "Created directory: $dir"
    fi
  done

  success "Claude directory structure ready"
}

# Clone or update claude-agents repository
setup_claude_agents() {
  info "Setting up Claude agents repository..."

  # Ensure Dev/Forks directory exists
  mkdir -p "$(dirname "$AGENTS_REPO")"

  if [ ! -d "$AGENTS_REPO" ]; then
    info "Cloning claude-agents repository..."
    git clone https://github.com/hatfim/claude-agents.git "$AGENTS_REPO"
    success "Claude agents repository cloned"
  else
    info "Updating claude-agents repository..."
    cd "$AGENTS_REPO"
    git pull origin main || warning "Could not update claude-agents repository"
    cd - > /dev/null
    success "Claude agents repository updated"
  fi
}

# Create symlink to agents
link_claude_agents() {
  info "Linking Claude agents to Claude directory..."

  # Remove existing symlink if it exists
  if [ -L "$AGENTS_TARGET" ] || [ -e "$AGENTS_TARGET" ]; then
    rm -rf "$AGENTS_TARGET"
  fi

  # Create symlink
  if [ -d "$AGENTS_REPO/agents" ]; then
    ln -sf "$AGENTS_REPO/agents" "$AGENTS_TARGET"
    success "Claude agents linked successfully"
  else
    warning "Agents directory not found in repository"
  fi
}

# Setup Claude configuration
setup_claude_config() {
  info "Setting up Claude configuration..."

  local config_source="$DOTFILES/home/.config/claude/config.json"
  local config_target="$CLAUDE_DIR/config.json"

  if [ -f "$config_source" ]; then
    cp "$config_source" "$config_target"
    success "Claude configuration copied from dotfiles"
  else
    warning "Claude configuration not found in dotfiles"
  fi
}

# Install Claude Code package locally if needed
setup_claude_local() {
  info "Setting up Claude local package..."

  local local_dir="$CLAUDE_DIR/local"

  if [ ! -d "$local_dir" ]; then
    mkdir -p "$local_dir"
    cd "$local_dir"

    # Create package.json if it doesn't exist
    if [ ! -f "package.json" ]; then
      cat > package.json <<EOF
{
  "name": "claude-local",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.127"
  }
}
EOF
    fi

    # Install dependencies
    if command -v npm >/dev/null 2>&1; then
      npm install
      success "Claude local package installed"
    else
      warning "npm not found - Claude local package not installed"
    fi

    cd - > /dev/null
  else
    success "Claude local package already exists"
  fi
}

# Create Claude wrapper script if needed
setup_claude_wrapper() {
  local wrapper_script="$CLAUDE_DIR/local/claude"

  if [ ! -f "$wrapper_script" ]; then
    info "Creating Claude wrapper script..."

    cat > "$wrapper_script" <<'EOF'
#!/usr/bin/env node

// Claude CLI wrapper script
const { spawn } = require('child_process');
const path = require('path');

// Add Claude Code to the path
const claudePath = path.join(__dirname, 'node_modules', '@anthropic-ai', 'claude-code', 'bin', 'claude');

// Forward all arguments to the actual Claude CLI
const child = spawn(claudePath, process.argv.slice(2), {
  stdio: 'inherit',
  env: { ...process.env }
});

child.on('exit', (code) => {
  process.exit(code);
});
EOF

    chmod +x "$wrapper_script"
    success "Claude wrapper script created"
  fi
}

# Configure shell integration
setup_shell_integration() {
  info "Setting up shell integration..."

  # The alias is already configured in .zshrc via dotfiles
  # Just verify it exists
  if grep -q "claude=" "$HOME/.zshrc" 2>/dev/null; then
    success "Claude alias found in .zshrc"
  else
    warning "Claude alias not found in .zshrc - it should be added via dotfiles"
  fi
}

# Verify installation
verify_claude_setup() {
  info "Verifying Claude setup..."

  local checks_passed=0
  local total_checks=5

  # Check 1: Claude CLI available
  if command -v claude >/dev/null 2>&1; then
    success "✓ Claude CLI available"
    ((checks_passed++))
  else
    error "✗ Claude CLI not available"
  fi

  # Check 2: Claude directory structure
  if [ -d "$CLAUDE_DIR" ]; then
    success "✓ Claude directory structure exists"
    ((checks_passed++))
  else
    error "✗ Claude directory structure missing"
  fi

  # Check 3: Agents repository
  if [ -d "$AGENTS_REPO" ]; then
    success "✓ Claude agents repository available"
    ((checks_passed++))
  else
    error "✗ Claude agents repository missing"
  fi

  # Check 4: Agents symlink
  if [ -L "$AGENTS_TARGET" ]; then
    success "✓ Claude agents linked"
    ((checks_passed++))
  else
    error "✗ Claude agents not linked"
  fi

  # Check 5: Configuration
  if [ -f "$CLAUDE_DIR/config.json" ]; then
    success "✓ Claude configuration available"
    ((checks_passed++))
  else
    error "✗ Claude configuration missing"
  fi

  echo
  echo "Setup verification: $checks_passed/$total_checks checks passed"

  if [ $checks_passed -eq $total_checks ]; then
    return 0
  else
    return 1
  fi
}

# Show available agents
show_available_agents() {
  info "Available Claude agents:"

  if [ -d "$AGENTS_TARGET" ]; then
    echo
    echo "📁 Agent Categories:"
    for category in "$AGENTS_TARGET"/*; do
      if [ -d "$category" ]; then
        echo "  $(basename "$category")/"
        for agent in "$category"/*.md; do
          if [ -f "$agent" ]; then
            echo "    - $(basename "$agent" .md)"
          fi
        done
      fi
    done
  else
    warning "Agents directory not found"
  fi
}

# Main setup function
main() {
  echo "🤖 Claude Development Environment Setup"
  echo "======================================"

  check_claude_cli
  check_claude_auth
  setup_claude_directories
  setup_claude_agents
  link_claude_agents
  setup_claude_config
  setup_claude_local
  setup_claude_wrapper
  setup_shell_integration

  echo
  if verify_claude_setup; then
    show_available_agents

    echo
    success "✅ Claude development environment setup complete!"
    echo
    echo "🚀 Next steps:"
    echo "• Use 'claude --help' to see available commands"
    echo "• Try 'claude chat' to start an interactive session"
    echo "• Use agents with '@agent-name' in your prompts"
    echo "• Check '~/.claude/agents/awesome-claude-agents/' for available agents"
    echo
    echo "💡 Tips:"
    echo "• Use 'claude validate' to check your setup"
    echo "• Agents are token-intensive - monitor your usage"
    echo "• Update agents with 'git pull' in $AGENTS_REPO"
  else
    error "❌ Setup completed with issues. Please check the output above."
    exit 1
  fi
}

# Run if script is executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi